# Frontend Environment Variables

# Stripe Publishable Key (from Stripe Dashboard)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Backend API URL
# For production (Render): https://your-service.onrender.com
# For local development: leave empty or set to http://localhost:5000
VITE_API_URL=http://localhost:5000

# CDN URL for static assets (optional)
# For production CDN deployments
# VITE_CDN_URL=https://cdn.example.com/

# Environment name
# VITE_ENV=production
